#!/usr/bin/env bash
# hooks/pre-push — Prevent pushing proprietary branches or references to public GitHub ('origin' / 'github')
set -euo pipefail

remote="$1"
url="$2"

# Enforce strict checks when pushing to 'origin', 'github', or any github.com URL
if [[ "$remote" == "origin" || "$remote" == "github" || "$url" == *"github.com"* ]]; then
  pattern_file="$(git rev-parse --git-dir)/leak_patterns"
  pattern=""
  if [[ -f "$pattern_file" ]]; then
    pattern=$(grep -v '^#' "$pattern_file" | paste -sd '|' - || true)
  fi

  while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue

    # 1. Only allow pushing master/main to public GitHub remote
    if [[ "$remote_ref" != "refs/heads/master" && "$remote_ref" != "refs/heads/main" ]]; then
      echo "ERROR: [pre-push] BLOCKED: Attempting to push non-main branch '$local_ref' -> '$remote_ref' to public remote '$remote'!" >&2
      exit 1
    fi

    # 2. Block if the commit tree contains any variant subdirectory
    if git ls-tree -r "$local_sha" --name-only | grep -qE '^variants/[^/]+/'; then
      echo "ERROR: [pre-push] BLOCKED: Commit $local_sha contains variant directory files!" >&2
      echo "       Refusing to push to public remote '$remote' ($url)." >&2
      exit 1
    fi

    # 3. Check commit diffs, commit messages, and author emails against local leak patterns
    if [[ -n "$pattern" ]]; then
      if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        range="$local_sha"
      else
        range="${remote_sha}..${local_sha}"
      fi

      diff_matches=$(git log "$range" -p | grep -iE "^\+.*($pattern)" || true)
      meta_matches=$(git log "$range" --format="%ae %ce %B" | grep -iE "($pattern)" || true)
      if [[ -n "$diff_matches" || -n "$meta_matches" ]]; then
        echo "ERROR: [pre-push] BLOCKED: Proprietary terms or metadata detected in commits being pushed to '$remote':" >&2
        [[ -n "$diff_matches" ]] && echo "$diff_matches" >&2
        [[ -n "$meta_matches" ]] && echo "$meta_matches" >&2
        exit 1
      fi
    fi
  done
fi

exit 0
